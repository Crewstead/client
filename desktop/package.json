{
  "name": "@crewstead/desktop",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "Crewstead for the desktop: your hub, with this computer's service built in.",
  "author": "Crewstead",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "app.crewstead.desktop",
    "productName": "Crewstead",
    "artifactName": "Crewstead-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "build/daemon/**",
      "node_modules/playwright-core/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "executableName": "crewstead",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "identity": null
    },
    "executableName": "crewstead",
    "publish": [
      {
        "provider": "github",
        "owner": "Crewstead",
        "repo": "client",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "crewstead.desktop"
}
