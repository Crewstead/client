{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "daemon/**/*.ts",
    "desktop/src/**/*.ts",
    "desktop/src/**/*.cts",
    "tests/unit/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
